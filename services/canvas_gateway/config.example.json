{
  "host": "127.0.0.1",
  "port": 7860,
  "work_dir": "L:/VideoGeneration/canvas_gateway/jobs",
  "canvas_dist": "H:/win-ai/infinite-canvas/web/dist",
  "exclusive_gpu": true,
  "default_voice": "配音 Lyra (tts)",
  "services": {
    "comfyui": {
      "url": "http://127.0.0.1:8189",
      "health": "/system_stats",
      "start": ["H:/ComfyUI-aki-v3.2/python/python.exe", "-s", "main.py", "--port", "8189",
                "--fast", "fp16_accumulation", "--use-sage-attention"],
      "cwd": "H:/ComfyUI-aki-v3.2/ComfyUI",
      "start_timeout": 300,
      "idle_stop_minutes": 10
    },
    "tts": {
      "url": "http://127.0.0.1:9880",
      "health": "/health",
      "start": ["H:/win-ai/index-tts/.venv/Scripts/python.exe", "-m", "services.local_tts.server"],
      "cwd": "H:/win-ai/OpenMontage",
      "env": {"LOCAL_TTS_BACKEND": "indextts25", "LOCAL_TTS_MODEL_DIR": "checkpoints_25",
              "PYTHONPATH": "H:/win-ai/index-tts;H:/win-ai/OpenMontage",
              "LOCAL_TTS_VOICES_DIR": "L:/VideoGeneration/素材库/音色/克隆参考"},
      "start_timeout": 300,
      "idle_stop_minutes": 10
    }
  },
  "models": [
    {
      "name": "Qwen 出图 (image)",
      "easy": {"button": "出图", "icon": "🖼", "minutes": 1, "hint": "用一句话描述想要的画面，越具体越好。",
               "fields": [{"type": "prompt", "label": "想要什么画面", "placeholder": "例如：一位穿白衬衫的年轻女孩站在海边，傍晚，电影感"}],
               "sizes": [{"value": "768x1344", "label": "竖屏 9:16"}, {"value": "1344x768", "label": "横屏 16:9"}, {"value": "1024x1024", "label": "方形"}]},
      "capability": "image",
      "type": "comfyui",
      "service": "comfyui",
      "workflow": "H:/win-ai/canvas_gateway/workflows/qwen21_t2i_api.json",
      "output_node": "<SaveImage 节点 ID>",
      "default_size": [768, 1344],
      "size_multiple": 16,
      "max_pixels": 2400000,
      "max_count": 4,
      "inputs": {
        "prompt": ["<正向提示词节点 ID>", "text"],
        "seed": ["<KSampler 节点 ID>", "seed"],
        "width": ["<EmptyLatent 节点 ID>", "width"],
        "height": ["<EmptyLatent 节点 ID>", "height"]
      }
    },
    {
      "name": "H3 图生视频 (video)",
      "easy": {"button": "图片变视频", "icon": "🎞", "minutes": 4, "hint": "放一张图当第一帧，写一句它怎么动。",
               "fields": [{"type": "image", "label": "第一帧图片"},
                          {"type": "prompt", "label": "画面怎么动", "placeholder": "例如：她转头微笑，向镜头挥手"},
                          {"type": "seconds", "label": "时长（秒）", "default": 5, "max": 15}],
               "sizes": [{"value": "1280x736", "label": "横屏 720p"}, {"value": "736x1280", "label": "竖屏 720p"}]},
      "capability": "video",
      "type": "comfyui",
      "service": "comfyui",
      "workflow": "H:/win-ai/canvas_gateway/workflows/h3_i2v_api.json",
      "output_node": "<SaveVideo 节点 ID>",
      "default_size": [1280, 736],
      "max_pixels": 950000,
      "fps": 24,
      "frame_grid": [17, 5],
      "max_seconds": 15,
      "min_images": 1,
      "timeout_seconds": 7200,
      "inputs": {
        "prompt": ["<提示词节点 ID>", "text"],
        "seeds": [["<采样器节点 ID>", "noise_seed"]],
        "width": ["<尺寸节点 ID>", "width"],
        "height": ["<尺寸节点 ID>", "height"],
        "frames": ["<尺寸节点 ID>", "length"],
        "images": [["<首帧 LoadImage 节点 ID>", "image"]]
      }
    },
    {
      "name": "H3 口播 (video)",
      "easy": {"button": "数字人口播", "icon": "🗣", "minutes": 25, "hint": "放一张人物照片，再给一段录音或直接打字配音。22 秒左右的口播大约 25 分钟。",
               "fields": [{"type": "image", "label": "人物照片（第一帧）"}, {"type": "speech", "label": "声音"},
                          {"type": "prompt", "label": "动作和表情", "optional": true, "placeholder": "例如：微笑着对镜头说话，偶尔点头"}]},
      "capability": "video",
      "type": "command",
      "services": ["comfyui"],
      "min_images": 1,
      "min_audios": 1,
      "default_size": [1280, 736],
      "timeout_seconds": 14400,
      "cwd": "L:/VideoGeneration/tools/h3-longvideo",
      "command": ["H:/win-ai/OpenMontage/.venv/Scripts/python.exe", "make_film.py",
                  "--first-frame", "{image1}", "--audio", "{audio1}", "--prompt-file", "{prompt_file}",
                  "--quality", "720", "--out", "{out}", "--work", "{job_dir}"]
    },
    {
      "name": "配音 Lyra (tts)",
      "easy": {"button": "配音 Lyra", "icon": "🎙", "minutes": 1, "fields": [{"type": "prompt", "label": "要念的文字"}]},
      "capability": "audio",
      "type": "tts",
      "service": "tts",
      "voice": "<克隆参考里的音色名>"
    }
  ]
}
